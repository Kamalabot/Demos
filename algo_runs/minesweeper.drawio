                </mxCell>
                <mxCell id="2" value="&lt;p style=&quot;margin:0 0 4px 0;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;b&gt;Problem Statement:&lt;/b&gt; The goal is to find where all the mines are located within an &lt;i&gt;M × N&lt;/i&gt; field. The game displays a number in each square indicating how many mines are adjacent to it (at most 8 neighbors: horizontally, vertically, and diagonally).&lt;/font&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;The &lt;b&gt;4×4 field on the left&lt;/b&gt; contains two mines (&lt;b&gt;*&lt;/b&gt;). Replacing each non-mine cell with its adjacent mine count yields the &lt;b&gt;hint field on the right&lt;/b&gt;:&lt;/font&gt;&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E1E4E8;strokeWidth=1;fontSize=11;align=left;spacingLeft=12;spacingRight=12;" parent="1" vertex="1">
                    <mxGeometry x="40" y="80" width="820" height="80" as="geometry"/>
                </mxCell>
