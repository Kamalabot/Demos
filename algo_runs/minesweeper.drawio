                <mxCell id="header_banner" value="&lt;b style=&quot;font-size:16px;&quot;&gt;&lt;font color=&quot;#030303&quot;&gt;MINESWEEPER: 4 × 4 FIELD TRANSFORMATION&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#555;&quot;&gt;From raw mine locations to 8-neighborhood hint numbers (UVa 10189 / PC Chapter 1)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#D0D7DE;strokeWidth=1.5;align=center;" parent="1" vertex="1">
