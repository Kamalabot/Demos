                <mxCell id="rule_desc" value="&lt;b style=&quot;font-size:10px;color:#0F172A;&quot;&gt;Algorithm Rule:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9.5px;color:#475569;&quot;&gt;For each safe cell &lt;b&gt;(r, c)&lt;/b&gt;:&lt;br&gt;hint = &amp;Sigma; [grid[r+dr][c+dc] == '*']&lt;br&gt;where dr, dc &amp;isin; {-1, 0, 1} and (dr, dc) &amp;ne; (0,0)&lt;br&gt;Boundary: 0 &amp;le; r+dr &amp;lt; M, 0 &amp;le; c+dc &amp;lt; N&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=left;spacingLeft=8;spacingRight=8;" parent="1" vertex="1">
