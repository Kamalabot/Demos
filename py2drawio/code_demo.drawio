                <mxCell id="main_init" value="&lt;b&gt;1. Variable Initialization (Stack Frame)&lt;/b&gt;&lt;br&gt;&lt;code&gt;student_name = 'Arjun' (str)&lt;/code&gt;&lt;br&gt;&lt;code&gt;passing_mark = 40 (int)&lt;/code&gt;&lt;br&gt;&lt;code&gt;is_enrolled = True (bool)&lt;/code&gt;&lt;br&gt;&lt;code&gt;exam_scores = [85, 62, 35, 90] (list)&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.2;align=left;spacingLeft=10;fontSize=10.5;fontColor=#121212;" parent="1" vertex="1">
                    <mxGeometry x="90" y="190" width="360" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="main_for_header" value="&lt;b&gt;2. For Loop: enumerate(exam_scores)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Iterate: index, current_score (4 items)&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;size=15;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=1.5;align=center;fontColor=#080808;" parent="1" vertex="1">
                    <mxGeometry x="100" y="290" width="340" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="main_grade_call" value="&lt;b&gt;Call: assign_grade(current_score)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;grade = assign_grade(current_score)&lt;br&gt;print(f'Exam {index+1}: Score={current_score} | Grade={grade}')&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.2;align=center;fontSize=10;fontColor=#080808;" parent="1" vertex="1">
                    <mxGeometry x="100" y="355" width="340" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="main_try_header" value="&lt;b&gt;3. Error Handling Block: try&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Guards calculation against empty sequence&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#6EE7B7;strokeWidth=1.2;align=center;fontColor=#080808;" parent="1" vertex="1">
                    <mxGeometry x="100" y="425" width="340" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="main_calc_avg" value="&lt;b&gt;Call: calculate_average(exam_scores)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;avg = calculate_average(exam_scores) [returns 68.0]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.2;align=center;fontColor=#000000;" parent="1" vertex="1">
