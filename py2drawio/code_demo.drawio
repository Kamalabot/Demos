                <mxCell id="sub2_start" value="&lt;b&gt;def calculate_average(scores)&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1.5;align=center;fontColor=#0D0D0D;" parent="1" vertex="1">
