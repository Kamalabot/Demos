                <mxCell id="e_call_sub1" value="Invokes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#4B5563;fontSize=10;;dashed=1;strokeColor=#2563EB;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;" parent="1" source="main_grade_call" target="sub1_start" edge="1">
