                <mxCell id="panel_trace" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E2E8F0;strokeWidth=1.5;" parent="1" vertex="1">
                    <mxGeometry x="520" y="545" width="860" height="485" as="geometry"/>
                </mxCell>
                <mxCell id="title_trace" value="&lt;b&gt;RUNTIME MEMORY STATE &amp;amp; CONCRETE EXECUTION TRACE (ARJUN'S RUN)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;Step-by-step variable evaluation, console outputs, and loop states&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#030303;" parent="1" vertex="1">
                    <mxGeometry x="520" y="550" width="860" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="trace_vars" value="&lt;b&gt;1. Global / main() Scope Memory&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; style=&quot;border-collapse:collapse;width:100%;font-size:9.5px;text-align:left;&quot;&gt;&lt;tbody&gt;&lt;tr style=&quot;background:#E2E8F0;&quot;&gt;&lt;th&gt;Identifier&lt;/th&gt;&lt;th&gt;Type&lt;/th&gt;&lt;th&gt;Value&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;student_name&lt;/code&gt;&lt;/td&gt;&lt;td&gt;str&lt;/td&gt;&lt;td&gt;'Arjun'&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;passing_mark&lt;/code&gt;&lt;/td&gt;&lt;td&gt;int&lt;/td&gt;&lt;td&gt;40&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;is_enrolled&lt;/code&gt;&lt;/td&gt;&lt;td&gt;bool&lt;/td&gt;&lt;td&gt;True&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;exam_scores&lt;/code&gt;&lt;/td&gt;&lt;td&gt;list&lt;/td&gt;&lt;td&gt;[85, 62, 35, 90]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;avg&lt;/code&gt;&lt;/td&gt;&lt;td&gt;float&lt;/td&gt;&lt;td&gt;68.0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;code&gt;countdown&lt;/code&gt;&lt;/td&gt;&lt;td&gt;int&lt;/td&gt;&lt;td&gt;3 → 2 → 1 → 0&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=8;spacingRight=8;fontColor=#050505;" parent="1" vertex="1">
                    <mxGeometry x="540" y="585" width="260" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="trace_scores" value="&lt;b&gt;2. Grade Evaluation Trace: for index, current_score in enumerate(exam_scores)&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; style=&quot;border-collapse:collapse;width:100%;font-size:9.5px;text-align:center;&quot;&gt;&lt;tbody&gt;&lt;tr style=&quot;background:#E2E8F0;&quot;&gt;&lt;th&gt;Iter&lt;/th&gt;&lt;th&gt;index&lt;/th&gt;&lt;th&gt;score&lt;/th&gt;&lt;th&gt;Branch Evaluated&lt;/th&gt;&lt;th&gt;Return Grade&lt;/th&gt;&lt;th&gt;Console Output&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;#1&lt;/td&gt;&lt;td&gt;0&lt;/td&gt;&lt;td&gt;85&lt;/td&gt;&lt;td&gt;&lt;code&gt;score &amp;gt;= 80&lt;/code&gt; (85 ≥ 80)&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;&quot;&gt;'A'&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Exam 1: Score = 85 | Grade = A&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;#2&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;62&lt;/td&gt;&lt;td&gt;&lt;code&gt;score &amp;gt;= 60&lt;/code&gt; (62 ≥ 60)&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;&quot;&gt;'B'&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Exam 2: Score = 62 | Grade = B&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;#3&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;35&lt;/td&gt;&lt;td&gt;&lt;code&gt;else&lt;/code&gt; (35 &amp;lt; 40)&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;&quot;&gt;'Fail'&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Exam 3: Score = 35 | Grade = Fail&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;#4&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;90&lt;/td&gt;&lt;td&gt;&lt;code&gt;score &amp;gt;= 80&lt;/code&gt; (90 ≥ 80)&lt;/td&gt;&lt;td&gt;&lt;b style=&quot;&quot;&gt;'A'&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Exam 4: Score = 90 | Grade = A&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=8;spacingRight=8;fontColor=#050505;" parent="1" vertex="1">
                    <mxGeometry x="820" y="585" width="545" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="trace_calc" value="&lt;b&gt;3. calculate_average Execution Breakdown&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;• &lt;b&gt;Input list:&lt;/b&gt; &lt;code&gt;[85, 62, 35, 90]&lt;/code&gt; (len = 4, non-empty)&lt;br&gt;• &lt;b&gt;Accumulator steps:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;1) total = 0 + 85 = 85&lt;br&gt;&amp;nbsp;&amp;nbsp;2) total = 85 + 62 = 147&lt;br&gt;&amp;nbsp;&amp;nbsp;3) total = 147 + 35 = 182&lt;br&gt;&amp;nbsp;&amp;nbsp;4) total = 182 + 90 = 272&lt;br&gt;• &lt;b&gt;Mean Division:&lt;/b&gt; &lt;code&gt;average = 272 / 4 = 68.0&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Threshold Test:&lt;/b&gt; &lt;code&gt;68.0 &amp;gt;= 40&lt;/code&gt; → &lt;b style=&quot;&quot;&gt;Final Status: PASSED&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=8;spacingRight=8;fontColor=#050505;" parent="1" vertex="1">
                    <mxGeometry x="540" y="785" width="390" height="225" as="geometry"/>
                </mxCell>
                <mxCell id="trace_countdown" value="&lt;b&gt;4. Countdown Loop &amp;amp; Complete Console Output&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;• &lt;b&gt;While Loop State Transitions:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;countdown=3 &amp;gt; 0 → Log: &lt;i&gt;Closing session in 3...&lt;/i&gt; → countdown=2&lt;br&gt;&amp;nbsp;&amp;nbsp;countdown=2 &amp;gt; 0 → Log: &lt;i&gt;Closing session in 2...&lt;/i&gt; → countdown=1&lt;br&gt;&amp;nbsp;&amp;nbsp;countdown=1 &amp;gt; 0 → Log: &lt;i&gt;Closing session in 1...&lt;/i&gt; → countdown=0&lt;br&gt;&amp;nbsp;&amp;nbsp;countdown=0 &amp;gt; 0 is False → Loop Terminates.&lt;br&gt;• &lt;b&gt;Complete STDOUT Output:&lt;/b&gt;&lt;br&gt;&lt;pre style=&quot;margin:2px 0 0 0;font-size:9px;background:#F8FAFC;padding:4px;border:1px solid #E2E8F0;border-radius:4px;&quot;&gt;Student: Arjun&#10;Enrolled: True&#10;-------------------------&#10;Exam 1: Score = 85 | Grade = A&#10;Exam 2: Score = 62 | Grade = B&#10;Exam 3: Score = 35 | Grade = Fail&#10;Exam 4: Score = 90 | Grade = A&#10;-------------------------&#10;Average Score: 68.0&#10;Final Status: PASSED&#10;-------------------------&#10;Done.&lt;/pre&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=8;spacingRight=8;fontColor=#050505;" parent="1" vertex="1">
                    <mxGeometry x="950" y="785" width="415" height="225" as="geometry"/>
                </mxCell>
                <mxCell id="2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#4B5563;fontSize=10;;dashed=1;strokeColor=#2563EB;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;endArrow=none;" edge="1" parent="1" source="main_calc_avg" target="sub2_d_empty">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="440" y="507.48275862068976" as="sourcePoint"/>
                        <mxPoint x="1165.0344827586207" y="165" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="sub2_d_empty" value="&lt;b&gt;if not scores:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9.5px;&quot;&gt;len(scores) == 0?&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#FACC15;strokeWidth=1.5;align=center;fontColor=#242424;" parent="1" vertex="1">
                    <mxGeometry x="1072.5" y="185" width="185" height="50" as="geometry"/>
