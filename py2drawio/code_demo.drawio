                <mxCell id="sub1_retC" value="&lt;b&gt;return 'C'&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;align=center;fontColor=#92400E;" parent="1" vertex="1">
