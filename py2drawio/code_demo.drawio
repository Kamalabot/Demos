                <mxCell id="sub1_retB" value="&lt;b&gt;return 'B'&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#38BDF8;strokeWidth=1.5;align=center;fontColor=#0369A1;" parent="1" vertex="1">
                    <mxGeometry x="840" y="305" width="75" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="sub1_d40" value="&lt;b&gt;elif score &amp;gt;= 40?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#FACC15;strokeWidth=1.5;align=center;fontColor=#000000;" parent="1" vertex="1">
