                <mxCell id="sub1_d80" value="&lt;b&gt;if score &amp;gt;= 80?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#FACC15;strokeWidth=1.5;align=center;fontColor=#000000;" parent="1" vertex="1">
