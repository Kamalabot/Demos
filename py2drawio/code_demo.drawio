                <mxCell id="sub2_raise" value="&lt;b&gt;raise ValueError&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9.5px;&quot;&gt;'Score list cannot be empty.'&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1.5;align=center;fontColor=#242424;" parent="1" vertex="1">
                    <mxGeometry x="965" y="260" width="180" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="sub2_accum" value="&lt;b&gt;Loop: Accumulate Total&lt;/b&gt;&lt;br&gt;&lt;code&gt;total = 0&lt;/code&gt;&lt;br&gt;&lt;code&gt;for score in scores:&lt;/code&gt;&lt;br&gt;&lt;code&gt;    total = total + score&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.2;align=left;spacingLeft=10;fontSize=10;" parent="1" vertex="1">
