                </mxCell>
                <mxCell id="main_decision_pass" value="&lt;b&gt;avg &amp;gt;= passing_mark?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 9.5px;&quot;&gt;(68.0 &amp;gt;= 40)&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#FACC15;strokeWidth=1.5;align=center;fontColor=#080808;" parent="1" vertex="1">
                    <mxGeometry x="170" y="550" width="200" height="60" as="geometry"/>
